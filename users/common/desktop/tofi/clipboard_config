# --- Window ---
anchor = left
width = 40%
height = 100%
padding-top = 4
padding-left = 8
padding-right = 0
background-color = #1f1f25
border-width = 0
border-color = #1f1f25
outline-width = 4
outline-color = #1f1f25
# --- Font ---
font = Fanwood Text Bold
font-size = 14
text-color = #c7c5d0

# --- Input ---
text-cursor = true
text-cursor-style = bar
prompt-text = ""
prompt-background = #34343a
prompt-background-padding = 4,-1,2,-1
prompt-background-corner-radius = 8
placeholder-text = "Search Clipboard"
placeholder-color = #c7c5d0
input-color = #e4e1e9

# --- List ---
selection-color = #dfe0ff
selection-background = #3c4279
selection-background-padding = 3,-1,3,-1
selection-background-corner-radius = 8
result-spacing = 8

# --- Others ---
clip-to-padding = false
fuzzy-match = true
