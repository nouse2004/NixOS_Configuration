"$schema" = 'https://starship.rs/config-schema.json'

format = """
$username\
$hostname\
$directory\
$conda\
$character"""

right_format = """
$git_branch\
$git_status\
$docker_context\
$python\
$rust\
$c\
$cpp\
$java\
$kotlin\
$golang\
$cmd_duration\
$time"""

palette='colors'
[palettes.colors]
normal = '{{colors.on_surface.default.hex}}'
primary = '{{colors.primary.default.hex}}'
secondary = '{{colors.secondary.default.hex}}'
tertiary = '{{colors.tertiary.default.hex}}'
error = '{{colors.error.default.hex}}'

[directory]
style = "primary"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = "󰝚 "
"Pictures" = " "
"Developer" = "󰲋 "

[character]
success_symbol = "[❯](normal)"
error_symbol = "[❯](error)"
vimcmd_symbol = "[❮](normal)"

[git_branch]
symbol = ""
format = '[\[$symbol $branch]($style)'
style = "tertiary"

[git_status]
style = "tertiary"
format = '[ $all_status$ahead_behind\]]($style)'

[cmd_duration]
format = '[\[$duration\]]($style)'
style = "secondary"

[nodejs]
symbol = ""
style = "secondary"
format = '[\[$symbol( $version)\]]($style)'

[c]
symbol = " "
style = "secondary"
format = '[\[$symbol( $version)\]]($style)'

[cpp]
symbol = " "
style = "secondary"
format = '[\[$symbol( $version)\]]($style)'

[rust]
symbol = ""
style = "secondary"
format = '[\[$symbol( $version)\]]($style)'

[golang]
symbol = ""
style = "secondary"
format = '[\[$symbol( $version)\]]($style)'

[java]
symbol = ""
style = "secondary"
format = '[\[$symbol( $version)\]]($style)'

[kotlin]
symbol = ""
style = "secondary"
format = '[\[$symbol( $version)\]]($style)'

[python]
symbol = ""
style = "secondary"
format = '[\[$symbol( $version)\]]($style)'

[docker_context]
symbol = ""
style = "secondary"
format = '[\[$symbol($context)\]]($style)'

[conda]
style = "tertiary"
format = '[ $symbol($environment) ]($style)'

[time]
disabled = false
time_format = "%R"
style = "normal"
format = '\[[ $time\]]($style)'
