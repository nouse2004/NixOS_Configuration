# --- Window ---
anchor = top
width = 100%
height = 30
horizontal = true
padding-top = 3
padding-bottom = 0
padding-left = 5
padding-right = 0
clip-to-padding = false
outline-width = 0
border-width = 0
background-color = {{colors.surface_container.default.hex}}

# --- Font ---
font = monospace
font-size = 14
text-color = {{colors.on_surface_variant.default.hex}}

# --- Input ---
text-cursor = true
prompt-text = "Run:"
prompt-color = {{colors.on_surface.default.hex}}
input-color = {{colors.on_surface.default.hex}}
require-match = false
min-input-width = 500
num-results = 5
selection-color = {{colors.primary.default.hex}}
result-spacing = 15

