# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{ config, lib, pkgs, modulesPath, ... }:

{
	imports = [
		(modulesPath + "/installer/scan/not-detected.nix")
	];

	# Boot
	boot.initrd.availableKernelModules = [ "nvme" "xhci_pci" "usbhid" "usb_storage" "sd_mod" ];
	boot.initrd.kernelModules = [ ];
	boot.kernelModules = [ "kvm-amd" ];
	boot.extraModulePackages = [ ];
	boot.supportedFilesystems = [ "ntfs" ];
	boot.kernelParams = [ "zswap.enable=0" ];

	# File systems
	fileSystems."/" = {
		device = "/dev/disk/by-uuid/7022b341-1986-4fbd-b78d-779438c48b67";
		fsType = "btrfs";
		options = [ "subvol=root" "compress=zstd" ];
	};
	fileSystems."/home" = {
		device = "/dev/disk/by-uuid/7022b341-1986-4fbd-b78d-779438c48b67";
		fsType = "btrfs";
		options = [ "subvol=home" "compress=zstd" ];
	};
	fileSystems."/nix" = {
		device = "/dev/disk/by-uuid/7022b341-1986-4fbd-b78d-779438c48b67";
		fsType = "btrfs";
		options = [ "subvol=nix" "noatime" "compress=zstd" ];
	};
	fileSystems."/boot" = {
		device = "/dev/disk/by-uuid/8FE3-6B4D";
		fsType = "vfat";
		options = [ "fmask=0077" "dmask=0022" ];
	};

	# Swap & OOM
	zramSwap = {
		enable = true;
		algorithm = "zstd";
		memoryPercent = 50;
		priority = 100;
	};
	swapDevices = [
		{
			device = "/var/lib/swapfile";
			size = 16 * 1024;
		}
	];
	systemd.oomd.enable = true;

	# Networking
	# Enables DHCP on each ethernet and wireless interface. In case of scripted networking
	# (the default) this is the recommended approach. When using systemd-networkd it's
	# still possible to use this option, but it's recommended to use it in conjunction
	# with explicit per-interface declarations with `networking.interfaces.<interface>.useDHCP`.
	networking.useDHCP = lib.mkDefault true;
	# networking.interfaces.enp5s0.useDHCP = lib.mkDefault true;
	# networking.interfaces.wlp4s0.useDHCP = lib.mkDefault true;

	# Host platform
	nixpkgs.hostPlatform = {
		#gcc = {
		#	arch = "znver4";
		#	tune = "znver4";
		#};
		system = "x86_64-linux";
	};
	#nix.settings.system_features = [
	#	"gccarch-znver4"
	#];

	# Hardware: CPU / GPU / Bluetooth
	hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
	hardware.graphics.enable = true;
	services.xserver.videoDrivers = [ "nvidia" ];
	hardware.nvidia = {
		open = true;
		package = config.boot.kernelPackages.nvidiaPackages.stable;
		modesetting.enable = true;
	};
	hardware.bluetooth = {
		enable = true;
		powerOnBoot = false;
	};
}
